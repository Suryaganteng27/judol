* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    user-select: none;
}

body, html {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: #0b0b0e;
}

#canvas-container {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
}

#ui-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

#header {
    background: rgba(15, 15, 25, 0.85);
    backdrop-filter: blur(8px);
    color: white;
    padding: 15px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid #00ffcc;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}

#player-info, #game-stats {
    display: flex;
    gap: 15px;
    font-size: 1.1rem;
    font-weight: bold;
}

#game-stats span, #player-info span {
    color: #00ffcc;
}

#notification {
    align-self: center;
    margin-top: 20px;
    background: rgba(0, 255, 204, 0.95);
    color: #000;
    padding: 10px 25px;
    border-radius: 20px;
    font-weight: bold;
    font-size: 1.2rem;
    box-shadow: 0 0 15px rgba(0, 255, 204, 0.6);
    transition: opacity 0.3s;
}

/* Power Meter Bar */
#power-bar-container {
    align-self: center;
    margin-bottom: 30px;
    background: rgba(0, 0, 0, 0.7);
    padding: 10px 20px;
    border-radius: 10px;
    border: 1px solid #00ffcc;
    text-align: center;
    color: white;
}

#power-bar-label {
    font-size: 0.8rem;
    margin-bottom: 5px;
    font-weight: bold;
    letter-spacing: 1px;
}

#power-bar-bg {
    width: 200px;
    height: 15px;
    background: #222;
    border-radius: 8px;
    overflow: hidden;
}

#power-bar-fill {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #00ffcc, #ffcc00, #ff0055);
}

.hidden {
    display: none !important;
}

/* Menu Overlay */
#menu-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(5, 5, 10, 0.9);
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: auto;
}

.menu-card {
    background: #14141e;
    padding: 40px;
    border-radius: 16px;
    border: 1px solid #2a2a3c;
    text-align: center;
    color: white;
    box-shadow: 0 10px 30px rgba(0,0,0,0.8);
    max-width: 380px;
    width: 90%;
}

.menu-card h1 {
    color: #00ffcc;
    margin-bottom: 10px;
    font-size: 2rem;
}

.menu-card p {
    margin-bottom: 25px;
    color: #aaa;
}

.menu-card button {
    display: block;
    width: 100%;
    padding: 14px;
    margin: 12px 0;
    font-size: 1rem;
    font-weight: bold;
    color: white;
    background: #0088cc;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
}

.menu-card button:hover {
    background: #00a0e6;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 160, 230, 0.4);
}
